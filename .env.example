GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant
# Render/most PaaS providers inject PORT automatically; AI_SERVER_PORT is only
# needed to pick a custom local port.
AI_SERVER_PORT=3001
# 0.0.0.0 is required in containers/PaaS so the process is reachable from
# outside localhost. Set HOST=127.0.0.1 to restrict a local run to loopback.
HOST=0.0.0.0
# Comma-separated allowed origins for the deployed frontend (e.g. your Vercel
# domain). Leave unset to allow any origin (fine for this stateless API/no
# cookies, but tighten it for stricter deployments).
CORS_ALLOWED_ORIGIN=
