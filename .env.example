# Frontend build-time configuration. Leave empty for same-origin API requests.
VITE_API_BASE_URL=

# Server-side AI provider. Never expose this key through a VITE_ variable.
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant
GROQ_API_URL=https://api.groq.com/openai/v1/chat/completions
GROQ_TIMEOUT_MS=30000

# Reference Node server.
AI_SERVER_PORT=3001
HOST=127.0.0.1
CORS_ORIGINS=http://127.0.0.1:5173
TRUST_PROXY=false
RATE_LIMIT_REQUESTS=30
RATE_LIMIT_WINDOW_MS=60000
NODE_ENV=development
